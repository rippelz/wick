# The builds wick is tested against (sober/poke.py's offsets are tied to SOBER_COMMIT + APK).
# `wick` warns at startup if the fork differs; `fetch-deps` installs exactly these.
# Waxley's own pins are in waxley/versions.env.
SOBER_VERSION=1.8.0
SOBER_COMMIT=7b6430c703e8178baa536062099fc5a1e0c7cf213c0789695fa7660b62cb9d26
SOBER_RUNTIME=org.gnome.Platform/x86_64/51
APK_VERSION=2.741.1061
APK_SHA256=9f4f4608fd51a9d01a6b8d403e2654fb985c56655ff9f06d6006e59972513f79
# Roblox only serves its newest APK, so this one is mirrored (packages/ + assets/ + state)
APK_ZIP_URL='https://drive.usercontent.google.com/download?id=11fitJksl7Gt77JyGKzsm6wBkuQh05Wa0&export=download&confirm=t'
APK_ZIP_SHA256=c11490fddeee8189b450aab210c4f996184defc41f0e46e4f11cca679ec854c5
# Luau at the engine's release: wick_place compiles scripts to the bytecode it reads
LUAU_VERSION=0.741
